# Persistance des leads via Supabase (table funnel_xr_discovery_leads, voir
# supabase/schema.sql et TODO.md). SUPABASE_SECRET_KEY = clé secrète
# « sb_secret_… » (service_role) : côté serveur UNIQUEMENT, JAMAIS de
# préfixe NEXT_PUBLIC_. Sans ces valeurs le site tourne en mode maquette
# (lead loggé en console, jamais bloquant).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Tracking (public, préfixe NEXT_PUBLIC_ obligatoire). Vides = aucun script
# tiers chargé, aucun cookie de mesure/pub (le site tourne normalement, le
# bandeau de consentement reste affiché mais n'injecte rien).
# NEXT_PUBLIC_GTM_ID        : conteneur GTM « GTM-XXXXXXX » (tagmanager.google.com).
#                             GA4 se branche DANS GTM, jamais dans le repo.
# NEXT_PUBLIC_META_PIXEL_ID : ID du Pixel Meta, 15-16 chiffres
#                             (Meta Events Manager → Sources de données).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
